# ==============================================================================
# AI Academic Assistant - Universal Environment Template
# Copy this file to .env in local environments. NEVER commit .env to version control.
# ==============================================================================

# Node.js API Gateway / BFF
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_a_secure_random_256bit_secret_in_production
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=replace_with_a_secure_refresh_secret
REFRESH_TOKEN_EXPIRATION=7d

# Internal Service Mesh Key (Shared secret between Express Gateway and FastAPI Engine)
INTERNAL_SERVICE_SECRET=replace_with_internal_mesh_hmac_secret

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/ai-academic-assistance
MONGODB_DATABASE=ai-academic-assistance

# Redis Task Queue & PubSub Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Python FastAPI AI Microservice
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
INTERNAL_FASTAPI_URL=http://localhost:8000

# ChromaDB Vector Store
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_PERSIST_DIRECTORY=./chroma_data

# AI & Embedding Model Settings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MAX_AGENT_ITERATIONS=3
TOKEN_BUDGET_PER_CHUNK=500
CHUNK_OVERLAP_TOKENS=50

# Optional External Academic API Keys (for citation lookup)
CROSSREF_API_MAILTO=research-admin@institution.edu
