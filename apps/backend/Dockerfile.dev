# Development Dockerfile for Express API Gateway (BFF)
FROM node:20-alpine

WORKDIR /app

# Install build tools for native compilation if required
RUN apk add --no-cache libc6-compat python3 make g++

# Copy workspace package definitions for efficient layer caching
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/backend/package.json ./apps/backend/

# Install dependencies (respecting package-lock.json)
RUN npm install

# Copy backend source code
COPY apps/backend/ ./apps/backend/

WORKDIR /app/apps/backend

EXPOSE 5000

# tsx watch enables sub-second TypeScript reloads
CMD ["npm", "run", "dev"]
