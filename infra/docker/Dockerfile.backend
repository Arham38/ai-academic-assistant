FROM node:20-alpine AS base
WORKDIR /app
COPY package*.json ./
COPY tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/backend/ ./apps/backend/
RUN npm install
RUN npm run build --workspace=@academic-assistant/backend
EXPOSE 5000
CMD ["npm", "run", "start", "--workspace=@academic-assistant/backend"]
